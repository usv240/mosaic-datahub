# Safe default: the web application cannot persist runs or publish to DataHub.
MOSAIC_PUBLIC_DEMO=true

# A local DataHub Core endpoint. Use a disposable environment for live evaluation.
MOSAIC_DATAHUB_URL=http://localhost:8080

# Never enable this on a public deployment. Local publication still requires a
# same-origin CSRF token and the exact human confirmation phrase.
MOSAIC_ENABLE_WEB_WRITEBACK=false

